{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // Los tests corren desde el vitest de la raíz y no se publican: `files` del
  // package.json es sólo `dist`, y compilarlos ahí los metería en el paquete.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
