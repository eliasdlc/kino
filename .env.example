# Kino · variables de entorno
#
# Copia este archivo a `.env.local` y rellena lo que uses. Next.js y drizzle-kit
# lo leen solos y git lo ignora. En Vercel las mismas claves viven en
# Settings → Environment Variables, con un valor por entorno.
#
# Obligatoria: sin ella la app no arranca o esa ruta falla cerrado.
# Opcional: van comentadas; descomenta la que uses. Sin ella se apaga una
# función y el resto sigue.

# ── Base de datos ─────────────────────────────────────────────────────────
# Obligatoria. Postgres con las extensiones uuid-ossp y ltree. En local apunta
# SIEMPRE a la rama de desarrollo de Neon o al Postgres de docker-compose
# (postgresql://kino:kino_dev_password@localhost:5433/kino). La cadena de
# producción sólo existe en la variable Production de Vercel.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Convex ────────────────────────────────────────────────────────────────
# Obligatoria. URL del deployment que el navegador y Next consultan. En local
# la escribe `npx convex dev` en `.env.local` junto con CONVEX_DEPLOYMENT; en
# Vercel, la del deployment de producción o de preview.
NEXT_PUBLIC_CONVEX_URL=
# Sólo local. Nombre del deployment de desarrollo (`dev:...`), lo escribe
# `npx convex dev`. Nunca en Vercel.
# CONVEX_DEPLOYMENT=
# Sólo CI y Vercel. Clave de deploy del deployment al que se publica. En una
# laptop vive en ~/.config/secretos/kino.env, no aquí.
# CONVEX_DEPLOY_KEY=

# ── Identidad (Clerk) ─────────────────────────────────────────────────────
# Obligatorias. Las dos claves de la instancia, en Configure → API keys del
# panel de Clerk. La de desarrollo empieza por pk_test_ / sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Obligatoria para Convex, no para Next: el emisor de la plantilla JWT
# `convex`, con la forma https://<algo>.clerk.accounts.dev. Se carga en el
# deployment con `npx convex env set CLERK_JWT_ISSUER_DOMAIN <url>`.
# CLERK_JWT_ISSUER_DOMAIN=
# Obligatoria en producción. Origen público de la app: callbacks de login,
# el recurso del MCP y los enlaces absolutos. En local, http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Crons ─────────────────────────────────────────────────────────────────
# Obligatoria para /api/cron/* (snapshot diario, recordatorios, barrido de
# imágenes). Sin ella esas rutas responden 500 a propósito: fallan cerrado.
# Generar: openssl rand -hex 32
CRON_SECRET=

# ── Sincronización con GitHub (issues → board de un sistema project) ──────
# Opcional. OAuth App aparte del login: GitHub admite un solo callback por app
# y leer issues privados exige el scope repo. Sin ellas la integración se
# oculta sola. Callback: <NEXT_PUBLIC_APP_URL>/api/integrations/github/callback
# GITHUB_SYNC_CLIENT_ID=
# GITHUB_SYNC_CLIENT_SECRET=
# Obligatoria si la sincronización está activa: cifra los tokens de GitHub
# antes de guardarlos. 32 bytes en base64: openssl rand -base64 32
# ENCRYPTION_KEY=

# ── Push (Web Push / VAPID) ───────────────────────────────────────────────
# Opcional. Sin el par no hay notificaciones push; recordatorios y crons
# siguen. Generar el par: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# El mismo valor que VAPID_PUBLIC_KEY, expuesto al navegador para suscribirse.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Opcional. Contacto que recibe el servicio push (mailto: o https).
# VAPID_SUBJECT=mailto:tu@correo

# ── Imágenes (Vercel Blob) ────────────────────────────────────────────────
# Opcional. Sin él la subida de imágenes responde 503 a propósito.
# BLOB_READ_WRITE_TOKEN=

# ── Reporte de errores (Sentry) ───────────────────────────────────────────
# Opcional. Sin DSN el reporte queda inerte y la app arranca igual: es el
# estado normal en local. Con él, los errores del navegador, de la API y de
# los crons llegan con su traza y el commit desplegado.
# NEXT_PUBLIC_SENTRY_DSN=
# Sólo para el build: suben los sourcemaps y se borran del bundle público, para
# que una traza se lea en Sentry sin publicar el código. Sin el token el build
# sale verde igual, pero las trazas de producción llegan minificadas.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Funnel de registro (PostHog) ──────────────────────────────────────────
# Opcional. Sin la clave la analítica queda inerte y la app arranca igual: es
# el estado normal en local. Con ella se miden los seis pasos que van de una
# landing de segmento a la primera tarea, y nada más — ni capturas
# automáticas, ni grabación de sesión, ni contenido de tareas o cuadernos.
# La clave pública del proyecto (`phc_...`), en Project settings → Project API key.
# NEXT_PUBLIC_POSTHOG_KEY=
# Opcional. Sólo para la región europea: https://eu.i.posthog.com. Por defecto
# apunta a la de EEUU (https://us.i.posthog.com).
# NEXT_PUBLIC_POSTHOG_HOST=
#
# Ojo, esto no es una variable: la medición sin cookies hay que activarla
# también en los ajustes del proyecto en PostHog. Sin eso los eventos llegan
# y se descartan en silencio.
